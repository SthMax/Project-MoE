{
  "run_id": "e1_2_variable_k",
  "description": "E1.2: Variable top-k experiment (quality-sparsity trade-off curve)",
  
  "model": {
    "model_id": "Qwen/Qwen3-30B-A3B-Instruct",
    "tensor_parallel_size": 4,
    "max_model_len": 4096,
    "max_num_seqs": 16,
    "dtype": "auto",
    "trust_remote_code": true,
    "enforce_eager": true,
    "disable_custom_all_reduce": true
  },
  
  "routing": {
    "mode": "variable_k",
    "top_k": 8,
    "alpha": null,
    "ema_decay": null,
    "use_original_weights": null,
    "_comment": "top_k values to sweep: [1, 2, 4, 8, 10] (model default is 8)"
  },
  
  "generation": {
    "max_tokens": 1,
    "temperature": 0.0
  },
  
  "evaluation": {
    "compute_ppl": true,
    "collect_routing_stats": true,
    "benchmark_throughput": false
  },
  
  "data": {
    "seed": 1234,
    "n_examples": 500,
    "max_prompt_tokens": 512
  },
  
  "domains": {
    "wikitext": {
      "hf_dataset": {
        "path": "wikitext",
        "name": "wikitext-103-raw-v1",
        "split": "train",
        "text_field": "text"
      }
    },
    "humaneval": {
      "hf_dataset": {
        "path": "openai_humaneval",
        "name": null,
        "split": "test",
        "text_field": "prompt"
      },
      "n_examples": 164,
      "allow_fewer_examples": true
    },
    "gsm8k": {
      "hf_dataset": {
        "path": "openai/gsm8k",
        "name": "main",
        "split": "test",
        "text_field": "question"
      },
      "n_examples": 500
    }
  },
  
  "output_root": "Code/Verification/E1.3/outputs/runs"
}
