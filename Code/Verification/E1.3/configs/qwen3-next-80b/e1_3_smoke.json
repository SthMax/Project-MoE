{
  "run_id": "e1_3_smoke_80b",
  "description": "Quick sanity check for PriceMoE routing - Qwen3-Next-80B",

  "run": {
    "load": "normal",
    "dataset": "wikitext"
  },
  
  "model": {
    "model_id": "Qwen/Qwen3-Next-80B-A3B-Instruct-FP8",
    "tensor_parallel_size": 4,
    "max_model_len": 4096,
    "max_num_seqs": 8,
    "dtype": "auto",
    "trust_remote_code": true,
    "enforce_eager": true,
    "disable_custom_all_reduce": true
  },
  
  "routing": {
    "mode": "price_moe",
    "top_k": null,
    "alpha": 0.1,
    "ema_decay": 0.9,
    "use_original_weights": true
  },
  
  "generation": {
    "max_tokens": 1,
    "temperature": 0.0
  },
  
  "evaluation": {
    "compute_ppl": false,
    "collect_routing_stats": true,
    "benchmark_throughput": false
  },
  
  "data": {
    "seed": 1234,
    "n_examples": 50,
    "max_prompt_tokens": 256
  },
  
  "domains": {
    "wikitext": {
      "hf_dataset": {
        "path": "wikitext",
        "name": "wikitext-103-raw-v1",
        "split": "train",
        "text_field": "text"
      }
    }
  },
  
  "output_root": "Code/Verification/E1.3/outputs/runs"
}
